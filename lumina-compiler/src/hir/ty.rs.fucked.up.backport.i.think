impl<'a> ts::Resolver<TypeKey> for TypeCheckPassHandler<'a> {
    fn implicitly_declare_generic(&mut self, tag: GenericTag) -> TaggedGeneric {
        implicitly_declare_generic(self.generic_names, self.fenv, tag)
    }

    fn type_of_field(
        &self,
        ident: &TypeKey,
        field: key::Field,
    ) -> Result<KnownType<TypeKey>, ResolverError<TypeKey>> {
        let (project, _) = self.ctx.resolve_module(self.project, ident.module);
        self.ctx
            .in_project(project, |unit| match &unit.header.typedefs[ident.key] {
                TypeDef::Struct { ftypes, .. } => Ok(ftypes[field].clone()),
                _ => Err(ResolverError::FieldNotFound(*ident, field)),
            })
    }

    fn guess_by_fields<'b, I>(&self, _fields: I) -> Option<TypeKey>
    where
        I: Iterator<Item = &'b str> + Clone,
    {
        None
    }

    fn get_field(&self, ident: &TypeKey, name: &str) -> Option<key::Field> {
        let (project, _) = self.ctx.resolve_module(self.project, ident.module);
        self.ctx
            .in_project(project, |unit| match &unit.header.typedefs[ident.key] {
                TypeDef::Struct { fnames, .. } => fnames
                    .iter()
                    .find_map(|(field, n)| (n == name).then_some(field)),
                _ => None,
            })
    }

    fn for_each_type_parameter<F>(&self, mut f: F)
    where
        F: FnMut(key::Generic),
    {
        for forall in self.fenv.values() {
            for generic in forall.generics.keys() {
                f(generic);
            }
        }
    }
}

impl<'s> TypeLower<'s> for TypeContext<InferenceEnv> {
    type Ty = Var;
    type Tys = EntityList<Var>;

    fn ty(&mut self, ty: Tr<&parser::Type<'s>>) -> Self::Ty {
        trace!("lowering type {ty}");

        let var = match *ty {
            parser::Type::Defined(ident, params) => {
                let path = ident.path.as_slice();
                let (plen, params) = self.tys(params);

                if let [name] = path {
                    if let Some(prim) = self.try_prim(name) {
                        check_param_count(*ty, plen.tr(ty.span), 0);
                        trace!("defining prim");
                        return self.define(ty.span, |env| env.prim(prim));
                    }

                    if let Some(generic) = self.try_generic(name) {
                        check_param_count(*ty, plen.tr(ty.span), 0); // TODO: higher-kinded types
                        return self.define(ty.span, |env| env.generic(generic));
                    }

                    if *name == "self" {
                        check_param_count(*ty, plen.tr(ty.span), 0); // TODO: higher-kinded types
                        return self.define(ty.span, |env| env.prim(Prim::Self_));
                    }
                }

                match self.defined(ty.span, &ident.path, params) {
                    Some(ty) => ty,
                    None => self.define(ty.span, |env| env.error()),
                }
            }
            parser::Type::Pointer(to) => {
                let to = self.ty((**to).as_ref());
                self.define(ty.span, |env| env.pointer(to))
            }
            parser::Type::FnPointer(ptypes, returns) => {
                let (_, params) = self.tys(ptypes);
                let ret = self.ty((**returns).as_ref());
                self.define(ty.span, |env| {
                    env.function(ts::CallableKind::FnPointer, params, ret)
                })
            }
            parser::Type::Closure(ptypes, returns) => {
                let (_, params) = self.tys(ptypes);
                let ret = self.ty((**returns).as_ref());
                self.define(ty.span, |env| {
                    env.function(ts::CallableKind::Closure, params, ret)
                })
            }
            parser::Type::Tuple(elems) => {
                let (_, elems) = self.tys(elems);
                self.define(ty.span, |env| env.tuple(elems))
            }
            parser::Type::Poison => self.define(ty.span, |env| env.error()),
            parser::Type::List(elems, len) => self
                .listlike(
                    ty.span,
                    elems,
                    len.clone(),
                    |this, len, of| this.define(ty.span, |env| env.array(len, of)),
                    |this, of| this.define(ty.span, |env| env.list(of)),
                )
                .unwrap_or_else(|| self.define(ty.span, |env| env.error())),
        };

        var
    }

    fn tys(&mut self, tys: &[Tr<parser::Type<'s>>]) -> (usize, EntityList<Var>) {
        let len = tys.len();
        let list = self.types_from_iter(tys, |this, ty| this.ty(ty.as_ref()));
        (len, list)
    }
}

impl<'s> TypeLower<'s> for TypeContext<StaticEnv> {
    type Ty = Type;
    type Tys = Vec<Type>;

    fn ty(&mut self, ty: Tr<&parser::Type<'s>>) -> Self::Ty {
        trace!("lowering type {ty}");

        match *ty {
            parser::Type::Defined(ident, params) => {
                let path = ident.path.as_slice();
                let (plen, params) = self.tys(params);

                if let [name] = path {
                    if let Some(prim) = self.try_prim(name) {
                        check_param_count(*ty, plen.tr(ty.span), 0);
                        return KnownType::Prim(prim);
                    }

                    if let Some(generic) = self.try_generic(name) {
                        check_param_count(*ty, plen.tr(ty.span), 0); // TODO: higher-kinded types
                        return KnownType::Generic(generic);
                    }

                    if *name == "self" {
                        check_param_count(*ty, plen.tr(ty.span), 0); // TODO: higher-kinded types
                        return self.env.self_.clone().expect("ET: No `self` in item");
                    }
                }

                match self.defined(ty.span, &ident.path, params) {
                    Some(ty) => ty,
                    None => KnownType::default_unit_type(),
                }
            }
            parser::Type::Pointer(to) => {
                let to = self.ty((**to).as_ref());
                KnownType::Pointer(Box::new(to))
            }
            parser::Type::FnPointer(ptypes, returns) => {
                let (_, params) = self.tys(ptypes);
                let ret = self.ty((**returns).as_ref());
                KnownType::Function {
                    kind: ts::CallableKind::FnPointer,
                    params,
                    ret: Box::new(ret),
                }
            }
            parser::Type::Closure(ptypes, returns) => {
                let (_, params) = self.tys(ptypes);
                let ret = self.ty((**returns).as_ref());
                KnownType::Function { kind: ts::CallableKind::Closure, params, ret: Box::new(ret) }
            }
            parser::Type::Tuple(elems) => {
                let (_, elems) = self.tys(elems);
                KnownType::Tuple(elems)
            }
            parser::Type::Poison => KnownType::default_unit_type(),
            parser::Type::List(elems, len) => self
                .listlike(
                    ty.span,
                    elems,
                    len.clone(),
                    |_, len, of| KnownType::Array { const_: len, of: Box::new(of) },
                    |_, of| KnownType::List(Box::new(of)),
                )
                .unwrap_or_else(|| KnownType::default_unit_type()),
        }
    }

    fn tys(&mut self, ty: &[Tr<parser::Type<'s>>]) -> (usize, Self::Tys) {
        let tys: Self::Tys = ty.iter().map(|ty| self.ty(ty.as_ref())).collect();
        (tys.len(), tys)
    }
}

impl TypeContext<StaticEnv> {
    pub fn member_of_trait<'s>(
        ctx: Context<TranslationUnit>,
        project: key::Project,
        file: key::File,
        trait_sig: &TypeSig,
    ) -> TypeContext<StaticEnv> {
        let tag = GenericTag::Type_;
        let self_ = Some(KnownType::Prim(Prim::Self_));
        let mut this = TypeContext::new(ctx.clone(), project, file, StaticEnv { self_ }, tag);

        this.add_scope(GenericTag::Trait);

        // Clone the generics declared from the trait type parameters.
        this.declare_forall(
            GenericTag::Trait,
            trait_sig.generics.values().map(|name| name.as_str()),
        );

        this.add_scope(GenericTag::Func);
        this.scope = GenericTag::Func;

        this
    }

    pub fn add_constraints<'s>(&mut self, tag: GenericTag, con: &parser::when::Constraints<'s>) {
        let previous = std::mem::replace(&mut self.scope, tag);
        for (_, name, cons) in &con.generics {
            for con in cons {
                let ty = self.ty(con.as_ref());
                self.declare_constraint(*name, ty);
            }
        }
        self.scope = previous;
    }

    pub fn declare_constraint<'s>(&mut self, gname: &str, con: Type) {
        let generic = self.try_generic(gname).unwrap();
        let gdata = self
            .fenv
            .get_mut(&generic.tag)
            .unwrap()
            .generics
            .get_mut(generic.key)
            .unwrap();

        match con {
            KnownType::Defined(ident, params) => {
                // TODO: Ensure it's a trait here instead of later
                gdata.add_constraint(ident, params.values().cloned().collect());
            }
            _ => panic!("ET: not a trait"),
        }
    }
}

fn check_param_count(header: impl fmt::Display, got: Tr<usize>, exp: usize) -> bool {
    let err = |span, msg| {
        errors::err("invalid type").line(span, msg).emit();
        false
    };

    if *got < exp {
        err(
            got.span,
            format!("missing {} type parameters for `{header}`", exp - *got),
        )
    } else if *got > *got {
        err(got.span, format!("excess parameter for `{header}`"))
    } else {
        true
    }
}
