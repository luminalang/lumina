//! Records have extra syntactic sugar that's trickier to deal with. Here we try to desugar the
//! difference agnostically across expressions and patterns.

use lumina_parser as parser;
use lumina_util::Tr;

// Intermediate data structure to desugar `a.b.c` syntax
pub struct Field<'e, 's, T> {
    pub name: Tr<&'s str>,
    pub value: FieldValue<'e, 's, T>,
}

pub enum FieldValue<'e, 's, T> {
    Record(Vec<Field<'e, 's, T>>),
    Tail(Tr<&'e T>),
    Punned,
}

pub fn from_parsed<'e, 's, T, U, F>(
    fields: &[parser::Field<'s, U>],
    mut then: F,
) -> Vec<Field<'e, 's, T>>
where
    F: FnMut(&Tr<U>) -> T,
{
    fields
        .iter()
        .map(|f| field(&f.field_names, f.bind, f.value.as_ref(), &mut then))
        .collect()
}

fn field<'e, 's, U, T, F>(
    names: &[Tr<&'s str>],
    bind: Option<Tr<&'s str>>,
    value: Option<U>,
    then: &mut F,
) -> Field<'e, 's, T>
where
    F: FnMut(U) -> T,
{
    match names {
        &[name] => Field {
            name,
            value: match value {
                Some(value) => FieldValue::Tail(then(value)),
                None => FieldValue::Punned,
            },
        },
        [name, xs @ ..] => Field {
            name: *name,
            value: FieldValue::Record(vec![field(xs, bind, value, then)]),
        },
        [] => unreachable!(),
    }
}
