use super::{Parameter, TypeDef, TypeSig};
use crate::{
    errors, key,
    project::symbols::{self, Namespace},
    Context, InterResolved, TranslationUnit,
};
use itertools::Itertools;
use lumina_parser::{self as parser};
use tracing::info;
// use lumina_typesystem_new as ts;
use lumina_key::{EntityList, Map, SecondaryMap};
use lumina_typesystem::{
    self as ts, Annotation, Application, ArrayLen, ForallEnv, GenericTag, IntSize, KnownType,
    KnownTypeFormatter, Prim, ResolverError, TaggedGeneric, Var,
};
